# Project identity (lowercase letters, digits, dashes)
PROJECT_SLUG=change-me
COMPOSE_PROJECT_NAME=change-me
DEPLOY_ENV=development

# Public endpoints
PUBLIC_APP_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# Host bindings (bind internal tools to loopback by default)
SUPABASE_BIND_ADDRESS=127.0.0.1
SUPABASE_API_PORT=8000
SUPABASE_STUDIO_PORT=3001
POSTGRES_PORT=5432

# Database
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# JWT values must share the same secret and be generated for anon/service roles
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
JWT_EXPIRY=3600
SUPABASE_ANON_KEY=CHANGE_ME_SIGNED_ANON_JWT
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SIGNED_SERVICE_ROLE_JWT

# Dashboard
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
DASHBOARD_USERNAME=CHANGE_ME
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_DASHBOARD_PASSWORD

# Auth
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.invalid
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME=Application

# Storage and functions
STORAGE_FILE_SIZE_LIMIT=52428800
FUNCTIONS_VERIFY_JWT=true
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Pin reviewed images; mirror/sign them in your private registry for production.
IMAGE_REGISTRY=docker.io
SUPABASE_POSTGRES_IMAGE=supabase/postgres:15.8.1.085
SUPABASE_GOTRUE_IMAGE=supabase/gotrue:v2.177.0
SUPABASE_POSTGREST_IMAGE=postgrest/postgrest:v12.2.12
SUPABASE_REALTIME_IMAGE=supabase/realtime:v2.34.47
SUPABASE_STORAGE_IMAGE=supabase/storage-api:v1.25.7
SUPABASE_IMGPROXY_IMAGE=darthsim/imgproxy:v3.27.2
SUPABASE_META_IMAGE=supabase/postgres-meta:v0.89.3
SUPABASE_EDGE_RUNTIME_IMAGE=supabase/edge-runtime:v1.67.4
SUPABASE_KONG_IMAGE=kong:2.8.1
SUPABASE_STUDIO_IMAGE=supabase/studio:2025.06.30-sha-6f5982d
